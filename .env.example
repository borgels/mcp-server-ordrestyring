ORDRESTYRING_API_TOKEN=
ORDRESTYRING_TIMEOUT_MS=30000
ORDRESTYRING_AUDIT_LOG=
ORDRESTYRING_ENABLE_WRITES=false
ORDRESTYRING_POLICY_PATH=
# HMAC key for prepared-mutation hashes (random per process when empty).
ORDRESTYRING_PREPARE_SECRET=
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
MCP_ALLOWED_HOSTS=
# Required on non-loopback binds: at least 32 printable ASCII characters.
MCP_HTTP_TOKEN=
MCP_HTTP_ALLOW_UNAUTHENTICATED=false
MCP_AUTH_FAILURE_LIMIT=20
MCP_AUTH_FAILURE_WINDOW_MS=60000
